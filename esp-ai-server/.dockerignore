# ============================================================
# ESP-AI Server - .dockerignore
# ============================================================
# 排除不必要进入 Docker 构建上下文的文件，加速构建、减小镜像层
# ============================================================

# ---- Python 缓存与编译产物 ----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg

# ---- 虚拟环境 ----
.venv/
venv/
env/
.Python

# ---- 测试与覆盖率 ----
tests/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ---- 类型检查与 lint 缓存 ----
.mypy_cache/
.ruff_cache/

# ---- 构建产物 ----
build/
dist/

# ---- 文档 ----
docs/
src/docs/
*.md
!README.md

# ---- CI/CD 与版本控制 ----
.github/
.git/
.gitignore
.gitattributes

# ---- IDE / 编辑器 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 日志与运行时数据（用 volume 挂载，不打进镜像）----
*.log
logs/

# ---- 环境配置（敏感信息，不打进镜像）----
.env
.env.*
!.env.example

# ---- 本地运行时数据（用 volume 挂载）----
users.json
example_usage.py

# ---- Docker 自身文件 ----
Dockerfile
docker-compose.yml
.dockerignore
