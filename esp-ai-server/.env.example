# ESP-AI Server 环境变量配置
# 复制此文件为 .env 并填入真实密钥

# ============================================================
# 部署模式
# single - 单用户模式：ASR/LLM/TTS 配置只从 .env 读取
# multi  - 多用户模式：ASR/LLM/TTS 配置从数据库（devices 表）读取
# ============================================================
DEPLOY_MODE=single

# ============================================================
# 服务器配置
# ============================================================
HOST=0.0.0.0
PORT=8088
LOG_FORMAT=console
DEBUG_LOG=false
DEBUG_LOG_LEVEL=INFO

# 日志文件配置（不填则默认 logs/esp_ai.log）
# LOG_FILE_PATH=logs/esp_ai.log
# LOG_MAX_SIZE=10485760
# LOG_BACKUP_COUNT=5

# CORS 跨域配置（逗号分隔的来源列表）
# 生产环境必须设置为具体域名，例如：
#   CORS_ORIGINS=https://example.com,https://admin.example.com
# 留空则不允许跨域（最安全）
CORS_ORIGINS=

# ============================================================
# 数据库配置（SQLite，唯一持久化存储）
# 不填则使用默认值 data/espai.db
# ============================================================
# DATABASE_URL=sqlite+aiosqlite:///data/espai.db
# DATABASE_SYNC_URL=sqlite:///data/espai.db
# DATABASE_ECHO=false

# ============================================================
# 设备连接鉴权 & REST API 认证
# ============================================================
# AUTH_ENABLED=true 时启用认证（默认开启，安全优先）：
#   - 设备 WebSocket 连接需携带 ?key=<AUTH_API_KEY> 或数据库中设备独立 key
#   - REST API（设备控制/技能/MCP/表情包管理）仅接受 ADMIN_API_KEY
# AUTH_ENABLED=false 显式关闭认证（仅本地开发建议使用，REST API 将处于无保护状态）
AUTH_ENABLED=true
# AUTH_API_KEY: 设备连接密钥（WebSocket ?key= 参数），仅用于设备 WS 鉴权
# ADMIN_API_KEY: 管理后台专用密钥，用于 REST API 认证（X-API-Key 或 Authorization: Bearer）
# 建议设置为高强度随机字符串，与 AUTH_API_KEY 严格区分

# ============================================================
# 安全密钥配置（生产环境必须配置！）
# ============================================================
# JWT_SECRET: JWT 签名密钥，用于用户认证 token 的签发与验证
# 未配置时将生成随机临时密钥（重启后旧 token 全部失效）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET=

# FIELD_ENCRYPTION_KEY: 字段级加密密钥（base64 编码的 32 字节 Fernet 密钥）
# 用于加密数据库中的敏感字段（设备密钥、API Key 等）
# 未配置时将生成临时密钥（重启后已加密字段无法解密）
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=

# ============================================================
# 速率限制（三层）
# ============================================================
# 1. REST API 限流：每个客户端 IP 每分钟最大请求数，超限返回 429；设为 0 禁用
RATE_LIMIT_MAX_RPM=60

# 2. 全局并发限流：整个系统每分钟最大请求上限
PERF_RATE_LIMIT_GLOBAL_RPM=3000

# 3. 设备级限流：通过 POST /api/devices 创建设备时设置 rate_limit_rpm 字段
#    或通过 POST /api/devices/{mac}/config 更新；未设置时跟随 RATE_LIMIT_MAX_RPM

# ============================================================
# OTA 固件更新配置
# ============================================================
OTA_ENABLED=true
OTA_VERSION=1.45.79
OTA_BIN_URL=http://your-server-ip:8088/firmware/1.0.bin
OTA_BIN_ID=5d47bb925ea440b3b615f4ed6e4d2263
OTA_IS_OFFICIAL=0

# ============================================================
# 远程配置（管理后台集成，可选）
# ============================================================
# REMOTE_CONFIG_ENABLED=false
# REMOTE_CONFIG_URL=http://your-management-server:3000
# REMOTE_CONFIG_API_KEY=your-remote-config-key
# REMOTE_CONFIG_CACHE_TTL=300
# REMOTE_CONFIG_REFRESH_INTERVAL=60

# ============================================================
# 性能优化配置（支持 500+ 并发）
# ============================================================

# 全局并发控制
PERF_GLOBAL_MAX_CONCURRENT_SESSIONS=500
PERF_ENABLE_GLOBAL_CONCURRENCY_LIMIT=true

# 队列大小限制
PERF_AUDIO_QUEUE_MAX_SIZE=200
PERF_SEND_QUEUE_MAX_SIZE=500

# 内存保护
PERF_MAX_MESSAGES_PER_SESSION=100

# CPU 密集型任务线程池
PERF_PROCESS_POOL_MAX_WORKERS=8

# ============================================================
# ASR 语音识别配置
# ============================================================
ASR_PROVIDER=volcengine

# ASR 并发与超时
ASR_MAX_CONCURRENCY=100
ASR_NO_SPEECH_TIMEOUT=5
ASR_SILENCE_TIMEOUT=2

# ASR 连接池设置
ASR_POOL_ENABLED=true
ASR_POOL_MAX_SIZE=100
ASR_POOL_MIN_SIZE=2
ASR_POOL_HEARTBEAT_INTERVAL=30
ASR_POOL_IDLE_TIMEOUT=300
ASR_POOL_CONNECTION_TIMEOUT=15

# 火山引擎 ASR 配置（仅需 API Key，不使用 Access Key）
ASR_VOLCENGINE_API_KEY=
ASR_VOLCENGINE_RESOURCE_ID=volc.bigasr.sauc.duration
# ASR_VOLCENGINE_MODEL=bigmodel

# 腾讯 ASR 配置（provider=tencent 时使用）
# ASR_TENCENT_APP_ID=your-app-id
# ASR_TENCENT_SECRET_ID=your-secret-id
# ASR_TENCENT_SECRET_KEY=your-secret-key
# ASR_TENCENT_ENGINE=16k_zh

# ============================================================
# LLM 大模型配置（OpenAI 兼容接口）
# ============================================================
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# LLM 生成参数（可选）
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2000

# LLM 记忆系统
LLM_MEMORY_ENABLED=true
LLM_MEMORY_MAX_MESSAGES=20
LLM_MEMORY_MAX_TOKENS=2000

# 长期记忆（跨会话的耐久事实，通过摘要标签检索）
LLM_MEMORY_LONG_TERM_ENABLED=true
LLM_MEMORY_LONG_TERM_AUTO_EXTRACT=true

# LLM 系统提示词
LLM_SYSTEM_PROMPT=你的名字叫小智，是一个智能语音助手...

# ============================================================
# TTS 语音合成配置（火山引擎）
# ============================================================
TTS_VOLCENGINE_API_KEY=
TTS_VOLCENGINE_RESOURCE_ID=seed-tts-1.0
TTS_VOLCENGINE_VOICE_TYPE=zh_female_wanwanxiaohe_moon_bigtts
TTS_VOLCENGINE_SPEED=1.0
TTS_VOLCENGINE_VOLUME=1.0
TTS_VOLCENGINE_PITCH=1.0

# TTS 连接池设置
TTS_POOL_ENABLED=true
TTS_POOL_MAX_SIZE=100
TTS_POOL_MIN_SIZE=2
TTS_POOL_HEARTBEAT_INTERVAL=30
TTS_POOL_IDLE_TIMEOUT=300
TTS_POOL_CONNECTION_TIMEOUT=15

# ============================================================
# 唤醒配置
# ============================================================
WAKEUP_TEXT="我在呢"
ENABLE_WAKEUP_AUDIO=true
WAKE_AUDIO_CACHE_ENABLED=true
WAKE_AUDIO_PLAY_ENABLED=true
WAKE_AUDIO_SOURCE=tts
WAKE_AUDIO_ON_NEXT_ROUND=false

# ============================================================
# 情感检测配置
# ============================================================
# 启用后设备屏幕会根据对话内容显示对应表情
SERVER_EMOTION_ENABLED=true
# SERVER_EMOTION_GIF_DIR=emos
# SERVER_EMOTION_STATIC_DIR=static_emos

# ============================================================
# MCP 外部工具配置
# ============================================================
#MCP_SERVERS_JSON={"amap-maps":{"type":"streamable_http","url":"https://mcp.api-inference.modelscope.net/xxxxx/mcp"}}

# ============================================================
# 音乐播放配置
# ============================================================
# MUSIC_API_URL=http://192.168.31.178:2233
# LYRICS_OFFSET=400

# ============================================================
# AI 成长系统配置
# ============================================================
# 成长任务冷却时间（秒）
# 用户对话结束后，等待指定时间无新对话，才触发成长任务
# 作用：避免用户连续说话时频繁触发，同时收集更完整的对话内容
# 默认 300 秒（5 分钟），设置为 0 则立即触发
GROWTH_COOLDOWN_SECONDS=300

# ============================================================
# 优雅退出
# ============================================================
SHUTDOWN_GRACE_PERIOD=10

# ============================================================
# 微信 Bot 集成配置
# ============================================================
# Bot Token（通过扫码登录获取后自动持久化，或从管理后台填入已有 token）
# WECHAT_BOT_TOKEN=

# 微信 iLink API 地址（通常无需修改）
# WECHAT_BOT_BASE_URL=https://ilinkai.weixin.qq.com

# 微信 CDN 地址（用于图片上传，通常无需修改）
# WECHAT_BOT_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
